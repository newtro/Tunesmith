<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.scott.tunesmith.autobuild</string>
    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/scripts/autobuild.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>15</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>ThrottleInterval</key>
    <integer>15</integer>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/tunesmith-autobuild.err</string>
</dict>
</plist>
